{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PC Monitoring Dockers",
  "version": "0.1.7",
  "identifier": "com.pcmonitoring.dockers",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PC Monitoring Dockers",
        "width": 1224,
        "height": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Alberto02003",
    "copyright": "Copyright © 2024-2026 Alberto02003",
    "category": "DeveloperTool",
    "shortDescription": "Monitor and manage Linux servers via SSH with Docker integration",
    "longDescription": "PC Monitoring Dockers is a desktop application for monitoring Linux servers via SSH, managing Docker containers, and tracking system metrics in real-time.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxNzE1MjQ3MDBBMkVGNDgKUldSSTc2SUFSMUp4c1NvbWVhbnJnOXkrYjJNL2QrR2xDV0dLRmhpZWkwRlg2eEJQSkRZV0JvZDEK",
      "endpoints": [
        "https://github.com/Alberto02003/PcMonitor-Dockers/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
